{
  "name": "m365-photo-hub-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "test": "vitest run",
